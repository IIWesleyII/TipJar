# Copy to .env. Network: Base Sepolia (chain ID 84532).
# Use a Base Sepolia RPC endpoint.
RPC_URL=
# Circle's official Base Sepolia test USDC contract:
# https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Public wallet addresses. The deploying wallet becomes the fixed owner.
OWNER_ADDRESS=
TIPPER_ADDRESS=

# Fill in after deploying TipJar.
TIP_JAR_ADDRESS=

# Keep private keys and seed phrases out of this file.
# Sign transactions using an encrypted Foundry keystore.
